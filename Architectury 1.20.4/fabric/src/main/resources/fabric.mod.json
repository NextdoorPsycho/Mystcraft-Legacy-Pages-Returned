{
  "schemaVersion": 1,
  "id": "mystcraft",
  "version": "${version}",
  "name": "Mystcraft 2 - Pages Unturned",
  "description": "Mystcraft 2 - Pages Unturned brings the Myst series to modern Minecraft, allowing players to write and travel to custom Ages.",
  "authors": [
    "NextdoorPsycho",
    "XCompWiz"
  ],
  "contact": {},
  "license": "LGPL-3.0-only",
  "icon": "assets/mystcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "art.arcane.mystcraft.fabric.MystcraftFabric"
    ],
    "client": [
      "art.arcane.mystcraft.fabric.client.MystcraftFabricClient"
    ]
  },
  "mixins": [
    "mystcraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.20.2",
    "java": ">=17",
    "architectury": ">=10.1.20",
    "fabric-api": "*"
  }
